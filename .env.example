# AEROSAR Environment Variables Template
# Copy this file to .env to configure local settings:
#   cp .env.example .env

# OpenStreetMap & Tile Services
VITE_OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_OSM_NOMINATIM_URL="https://nominatim.openstreetmap.org/reverse"

# Tactical Default SAR Sector Coordinates
VITE_DEFAULT_LAT=11.4916
VITE_DEFAULT_LNG=76.2230
VITE_DEFAULT_SECTOR_NAME="Default SAR Base Sector"

# Optional External API Keys (Leave empty if using free open-source OSM providers)
# VITE_MAPBOX_ACCESS_TOKEN=
# VITE_WEATHER_API_KEY=
